---
import "../styles/global.css";
import Friend from "../components/Friends.astro";
import Button88x31 from "../components/Buttons.astro";
import NixStore from "../components/NixStore.astro";
import CenteredBody from "../components/CenteredBody.astro";
import { Image } from "astro:assets";
import minky from "../assets/god.jpg";

const targetDate = new Date("2025-10-17T00:00:00Z");
function daysSince(date) {
  const now = new Date();
  const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const startOfTarget = new Date(date.getFullYear(), date.getMonth(), date.getDate());

  const diffMs = startOfToday - startOfTarget;
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
  return diffDays;
}
const days = daysSince(targetDate);
---

